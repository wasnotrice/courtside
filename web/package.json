		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"fake-indexeddb": "^6.2.7",
		"svelte": "^5.41.0",
		"svelte-check": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^7.1.10",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"dexie": "^4.4.7",
		"phoenix": "^1.8.16"
