{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Courtside",
  "version": "0.1.0",
  "identifier": "dev.courtside.spike",
  "build": {
    "frontendDist": "../build",
    "devUrl": "https://localhost:5173",
    "beforeBuildCommand": "VITE_COURTSIDE_API=http://localhost:4000 VITE_START_TAB=sync VITE_SPIKE_DIAG=1 npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Courtside",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
