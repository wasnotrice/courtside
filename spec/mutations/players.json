{
  "given": {
    "programs": [
      {
        "id": "b1111111-1111-4111-8111-111111111111",
        "name": "Girls' basketball",
        "sport": "basketball"
      },
      {
        "id": "b2222222-2222-4222-8222-222222222222",
        "name": "Boys' basketball",
        "sport": "basketball"
      }
    ],
    "players": [
      {
        "id": "11111111-1111-4111-8111-111111111111",
        "program_id": "b1111111-1111-4111-8111-111111111111",
        "name": "Ana"
      }
    ]
  },
  "cases": [
    {
      "name": "creates a player",
      "mutation": {
        "name": "player.put",
        "args": {
          "id": "22222222-2222-4222-8222-222222222222",
          "program_id": "b1111111-1111-4111-8111-111111111111",
          "name": "Ben"
        }
      },
      "expect": {
        "rows": {
          "players": [
            {
              "id": "11111111-1111-4111-8111-111111111111",
              "program_id": "b1111111-1111-4111-8111-111111111111",
              "name": "Ana"
            },
            {
              "id": "22222222-2222-4222-8222-222222222222",
              "program_id": "b1111111-1111-4111-8111-111111111111",
              "name": "Ben"
            }
          ]
        }
      }
    },
    {
      "name": "trims the name",
      "mutation": {
        "name": "player.put",
        "args": {
          "id": "22222222-2222-4222-8222-222222222222",
          "program_id": "b1111111-1111-4111-8111-111111111111",
          "name": "  Ben  "
        }
      },
      "expect": {
        "rows": {
          "players": [
            {
              "id": "11111111-1111-4111-8111-111111111111",
              "program_id": "b1111111-1111-4111-8111-111111111111",
              "name": "Ana"
            },
            {
              "id": "22222222-2222-4222-8222-222222222222",
              "program_id": "b1111111-1111-4111-8111-111111111111",
              "name": "Ben"
            }
          ]
        }
      }
    },
    {
      "name": "a blank name is refused",
      "mutation": {
        "name": "player.put",
        "args": {
          "id": "22222222-2222-4222-8222-222222222222",
          "program_id": "b1111111-1111-4111-8111-111111111111",
          "name": "   "
        }
      },
      "expect": {
        "rejected": "Name can't be blank"
      }
    },
    {
      "name": "a name over 100 characters is refused",
      "mutation": {
        "name": "player.put",
        "args": {
          "id": "22222222-2222-4222-8222-222222222222",
          "program_id": "b1111111-1111-4111-8111-111111111111",
          "name": "BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB"
        }
      },
      "expect": {
        "rejected": "Name should be at most 100 character(s)"
      }
    },
    {
      "name": "an unknown program is refused",
      "mutation": {
        "name": "player.put",
        "args": {
          "id": "22222222-2222-4222-8222-222222222222",
          "program_id": "99999999-9999-4999-8999-999999999999",
          "name": "Ben"
        }
      },
      "expect": {
        "rejected": "That program no longer exists."
      }
    },
    {
      "name": "renames a player",
      "mutation": {
        "name": "player.put",
        "args": {
          "id": "11111111-1111-4111-8111-111111111111",
          "program_id": "b1111111-1111-4111-8111-111111111111",
          "name": "Ana B"
        }
      },
      "expect": {
        "rows": {
          "players": [
            {
              "id": "11111111-1111-4111-8111-111111111111",
              "program_id": "b1111111-1111-4111-8111-111111111111",
              "name": "Ana B"
            }
          ]
        }
      }
    },
    {
      "name": "a player can't move to another program",
      "mutation": {
        "name": "player.put",
        "args": {
          "id": "11111111-1111-4111-8111-111111111111",
          "program_id": "b2222222-2222-4222-8222-222222222222",
          "name": "Ana"
        }
      },
      "expect": {
        "rejected": "Program can't change after the player is created"
      }
    },
    {
      "name": "an update can send just the name",
      "mutation": {
        "name": "player.put",
        "args": {
          "id": "11111111-1111-4111-8111-111111111111",
          "name": "Ana B"
        }
      },
      "expect": {
        "rows": {
          "players": [
            {
              "id": "11111111-1111-4111-8111-111111111111",
              "program_id": "b1111111-1111-4111-8111-111111111111",
              "name": "Ana B"
            }
          ]
        }
      }
    },
    {
      "name": "a new player needs a name",
      "mutation": {
        "name": "player.put",
        "args": {
          "id": "22222222-2222-4222-8222-222222222222",
          "program_id": "b1111111-1111-4111-8111-111111111111"
        }
      },
      "expect": {
        "rejected": "Name can't be blank"
      }
    },
    {
      "name": "renaming a player to a blank name is refused",
      "mutation": {
        "name": "player.put",
        "args": {
          "id": "11111111-1111-4111-8111-111111111111",
          "name": "  "
        }
      },
      "expect": {
        "rejected": "Name can't be blank"
      }
    }
  ]
}
