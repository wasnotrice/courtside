{
  "given": {
    "programs": [
      {
        "id": "b1111111-1111-4111-8111-111111111111",
        "name": "Girls' basketball",
        "sport": "basketball"
      },
      {
        "id": "b2222222-2222-4222-8222-222222222222",
        "name": "Boys' basketball",
        "sport": "basketball"
      }
    ],
    "teams": [
      {
        "id": "e1111111-1111-4111-8111-111111111111",
        "program_id": "b1111111-1111-4111-8111-111111111111",
        "name": "Varsity",
        "default_rules": null
      }
    ]
  },
  "cases": [
    {
      "name": "creates a team",
      "mutation": {
        "name": "team.put",
        "args": {
          "id": "e2222222-2222-4222-8222-222222222222",
          "program_id": "b1111111-1111-4111-8111-111111111111",
          "name": "JV"
        }
      },
      "expect": {
        "rows": {
          "teams": [
            {
              "id": "e1111111-1111-4111-8111-111111111111",
              "program_id": "b1111111-1111-4111-8111-111111111111",
              "name": "Varsity",
              "default_rules": null
            },
            {
              "id": "e2222222-2222-4222-8222-222222222222",
              "program_id": "b1111111-1111-4111-8111-111111111111",
              "name": "JV",
              "default_rules": null
            }
          ]
        }
      }
    },
    {
      "name": "a blank name is refused",
      "mutation": {
        "name": "team.put",
        "args": {
          "id": "e2222222-2222-4222-8222-222222222222",
          "program_id": "b1111111-1111-4111-8111-111111111111",
          "name": ""
        }
      },
      "expect": {
        "rejected": "Name can't be blank"
      }
    },
    {
      "name": "an unknown program is refused",
      "mutation": {
        "name": "team.put",
        "args": {
          "id": "e2222222-2222-4222-8222-222222222222",
          "program_id": "99999999-9999-4999-8999-999999999999",
          "name": "JV"
        }
      },
      "expect": {
        "rejected": "That program no longer exists."
      }
    },
    {
      "name": "renames a team",
      "mutation": {
        "name": "team.put",
        "args": {
          "id": "e1111111-1111-4111-8111-111111111111",
          "program_id": "b1111111-1111-4111-8111-111111111111",
          "name": "Varsity A"
        }
      },
      "expect": {
        "rows": {
          "teams": [
            {
              "id": "e1111111-1111-4111-8111-111111111111",
              "program_id": "b1111111-1111-4111-8111-111111111111",
              "name": "Varsity A",
              "default_rules": null
            }
          ]
        }
      }
    },
    {
      "name": "a team can't move to another program",
      "mutation": {
        "name": "team.put",
        "args": {
          "id": "e1111111-1111-4111-8111-111111111111",
          "program_id": "b2222222-2222-4222-8222-222222222222",
          "name": "Varsity"
        }
      },
      "expect": {
        "rejected": "Program can't change after the team is created"
      }
    },
    {
      "name": "an update can send just the name",
      "mutation": {
        "name": "team.put",
        "args": {
          "id": "e1111111-1111-4111-8111-111111111111",
          "name": "Varsity A"
        }
      },
      "expect": {
        "rows": {
          "teams": [
            {
              "id": "e1111111-1111-4111-8111-111111111111",
              "program_id": "b1111111-1111-4111-8111-111111111111",
              "name": "Varsity A",
              "default_rules": null
            }
          ]
        }
      }
    },
    {
      "name": "sets a team's default rules",
      "mutation": {
        "name": "team.put",
        "args": {
          "id": "e1111111-1111-4111-8111-111111111111",
          "default_rules": {
            "periods": 2,
            "period_minutes": 20,
            "overtime_minutes": 5,
            "team_fouls_reset": "half",
            "bonus_at": 7,
            "bonus": "one_and_one",
            "double_bonus_at": 10,
            "foul_out_at": 5,
            "technicals_to_eject": 2
          }
        }
      },
      "expect": {
        "rows": {
          "teams": [
            {
              "id": "e1111111-1111-4111-8111-111111111111",
              "program_id": "b1111111-1111-4111-8111-111111111111",
              "name": "Varsity",
              "default_rules": {
                "periods": 2,
                "period_minutes": 20,
                "overtime_minutes": 5,
                "team_fouls_reset": "half",
                "bonus_at": 7,
                "bonus": "one_and_one",
                "double_bonus_at": 10,
                "foul_out_at": 5,
                "technicals_to_eject": 2
              }
            }
          ]
        }
      }
    },
    {
      "name": "a team's default rules are checked",
      "mutation": {
        "name": "team.put",
        "args": {
          "id": "e1111111-1111-4111-8111-111111111111",
          "default_rules": {
            "periods": 2,
            "period_minutes": 20,
            "overtime_minutes": 5,
            "team_fouls_reset": "half",
            "bonus_at": 7,
            "bonus": "three",
            "double_bonus_at": 10,
            "foul_out_at": 5,
            "technicals_to_eject": 2
          }
        }
      },
      "expect": {
        "rejected": "Rules are invalid: bonus"
      }
    }
  ]
}
