{
  "given": {
    "programs": [
      {
        "id": "b1111111-1111-4111-8111-111111111111",
        "name": "Girls' basketball",
        "sport": "basketball"
      }
    ],
    "players": [
      {
        "id": "11111111-1111-4111-8111-111111111111",
        "program_id": "b1111111-1111-4111-8111-111111111111",
        "name": "Ana"
      }
    ]
  },
  "cases": [
    {
      "name": "an unknown mutation name is refused",
      "mutation": {
        "name": "player.delete",
        "args": {
          "id": "11111111-1111-4111-8111-111111111111"
        }
      },
      "expect": {
        "rejected": "Unknown change type: player.delete"
      }
    },
    {
      "name": "an unknown argument is refused instead of dropped",
      "mutation": {
        "name": "player.put",
        "args": {
          "id": "11111111-1111-4111-8111-111111111111",
          "program_id": "b1111111-1111-4111-8111-111111111111",
          "name": "Ana",
          "jersey": "4"
        }
      },
      "expect": {
        "rejected": "Unknown field: jersey"
      }
    },
    {
      "name": "with several unknown arguments, the first alphabetically is named",
      "mutation": {
        "name": "result.clear",
        "args": {
          "drill_run_id": "a1111111-1111-4111-8111-111111111111",
          "player_id": "11111111-1111-4111-8111-111111111111",
          "zeta": 1,
          "alpha": 2
        }
      },
      "expect": {
        "rejected": "Unknown field: alpha"
      }
    },
    {
      "name": "an id that isn't a UUID is refused",
      "mutation": {
        "name": "player.put",
        "args": {
          "id": "abc",
          "program_id": "b1111111-1111-4111-8111-111111111111",
          "name": "Ben"
        }
      },
      "expect": {
        "rejected": "The server could not apply this change."
      }
    }
  ]
}
